{
  "name": "@fluxer-mcp/cli",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "mcpName": "io.github.tear1338/fluxer-mcp",
  "description": "Native Fluxer MCP server & CLI for AI agents (Claude Code, Claude Desktop, Codex, Cursor, VS Code) — Cloud & self-hosted support, 184 typed tools, blueprints, security audits, auto-remediation, and moderation.",
  "bin": {
    "fluxer-mcp": "./dist/cli.js",
    "fluxer-mcp-server": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fluxer",
    "fluxer-mcp",
    "ai",
    "claude",
    "codex",
    "cursor"
  ],
  "license": "Apache-2.0",
  "homepage": "https://docs.fluxer.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tear1338/fluxer-mcp.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md');require('node:fs').copyFileSync('../../LICENSE','LICENSE');require('node:fs').copyFileSync('../../NOTICE','NOTICE');\"",
    "postpack": "node -e \"try{require('node:fs').unlinkSync('README.md');require('node:fs').unlinkSync('LICENSE');require('node:fs').unlinkSync('NOTICE');}catch{}\""
  },
  "dependencies": {
    "@fluxer-mcp/core": "workspace:*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "commander": "^12.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fluxer-mcp/server-mocks": "workspace:*",
    "@types/node": "^22.20.5",
    "msw": "^2.12.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
