{
  "name": "@fluxer-mcp/core",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Native Fluxer Model Context Protocol core library with 172 typed tools, Cloud & self-hosted discovery, safety middleware, blueprints, security audits, and backup/restore.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fluxer",
    "fluxer-mcp",
    "ai",
    "claude",
    "codex",
    "cursor"
  ],
  "license": "Apache-2.0",
  "homepage": "https://docs.fluxer.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tear1338/fluxer-mcp.git",
    "directory": "packages/mcp-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md');require('node:fs').copyFileSync('../../LICENSE','LICENSE');require('node:fs').copyFileSync('../../NOTICE','NOTICE');\"",
    "postpack": "node -e \"try{require('node:fs').unlinkSync('README.md');require('node:fs').unlinkSync('LICENSE');require('node:fs').unlinkSync('NOTICE');}catch{}\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fluxerjs/rest": "^3.1.0",
    "@fluxerjs/types": "^3.3.0",
    "@fluxerjs/ws": "^3.1.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "cockatiel": "^3.2.1",
    "pino": "^9.5.0",
    "undici": "^6.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fluxer-mcp/server-mocks": "workspace:*",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "msw": "^2.12.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
